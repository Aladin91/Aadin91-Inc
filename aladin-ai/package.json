{
  "name": "aladin-ai",
  "version": "0.4.0",
  "description": "Offline-first JavaScript machine learning, NLP, retrieval, computer vision and decision engine for reusable browser applications.",
  "main": "dist/aladin-ai.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/aladin-ai.js",
    "./advanced": "./src/advanced.js",
    "./extra": "./src/extra.js",
    "./neural": "./src/neural.js",
    "./retrieval": "./src/retrieval.js",
    "./regression-trees": "./src/regression-trees.js",
    "./vision": "./src/vision.js",
    "./vision-ml": "./src/vision-ml.js",
    "./github-cloud": "./src/github-cloud.js",
    "./browser-utils": "./src/browser.js",
    "./browser": "./dist/aladin-ai.js",
    "./loader": "./dist/aladin-ai-loader.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/smoke.test.js && node tests/advanced.test.js && node tests/extra.test.js && node tests/neural.test.js && node tests/retrieval.test.js && node tests/regression-trees.test.js && node tests/browser.test.js && node tests/vision.test.js && node tests/vision-ml.test.js && node tests/github-cloud.test.js && node tests/dist.test.js",
    "test:core": "node tests/smoke.test.js",
    "test:advanced": "node tests/advanced.test.js",
    "test:extra": "node tests/extra.test.js",
    "test:neural": "node tests/neural.test.js",
    "test:retrieval": "node tests/retrieval.test.js",
    "test:regression-trees": "node tests/regression-trees.test.js",
    "test:browser": "node tests/browser.test.js",
    "test:vision": "node tests/vision.test.js",
    "test:vision-ml": "node tests/vision-ml.test.js",
    "test:github-cloud": "node tests/github-cloud.test.js",
    "test:dist": "node tests/dist.test.js",
    "benchmark": "node benchmarks/basic.js",
    "check": "npm run build && npm test"
  },
  "keywords": ["machine-learning", "nlp", "offline", "javascript", "computer-vision", "image-analysis", "image-classification", "image-similarity", "decision-tree", "random-forest", "neural-network", "kmeans", "naive-bayes", "anomaly-detection", "pca", "softmax", "clustering", "indexeddb", "github-pages", "explainable-ai", "bm25", "tfidf", "retrieval", "similarity-search", "regression-tree"],
  "license": "MIT"
}
